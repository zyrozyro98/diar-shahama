{
  "hosting": {
    "site": "null",
    "public": "public",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "null",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
        "destination": ""
      }
    ]
  },
  "database": {
    "rules": "null"
  },
  "firestore": {
    "rules": "null"
  },
  "storage": {
    "rules": "null"
  }
}
